# ---- Frontend (bundled into the browser: never put secrets here) ----
# Base URL of the EduFlix API (no trailing slash). Empty = same origin (Vite proxies /api to the local server).
VITE_API_URL=
# true  -> built-in mock data, no API needed
# false -> use the real API (server/, which uses your YouTube key)
VITE_USE_MOCK_API=true

# ---- Server only (read by server/, never bundled) ----
YOUTUBE_API_KEY=
# API_PORT=8787
# EDU_APPROVE_SCORE=65     minimum educational score (0-100) to publish a video
# INGEST_HOURS=12          background refresh interval
# ADMIN_TOKEN=             required header (x-admin-token) for POST /api/admin/ingest when not on localhost
